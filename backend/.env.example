# ─── Ailrac Backend — Environment Variables ───
# Copy this file to .env and fill in your actual values.

# Cloud Model Providers (use Gemini, OpenRouter, or both)
# Gemini: API key from Google AI Studio (starts with AIza) — NOT gcloud OAuth tokens (ya29./AQ.)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MY_TELEGRAM_ID=your_telegram_user_id_here
OPENROUTER_API_KEY=your_openrouter_api_key_here